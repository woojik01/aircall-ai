<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PRD-03: 마이크 권한. 필요한 시점에 최소 범위로 요청한다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- PRD-05: 백그라운드 음성 대화 (Foreground Service + 지속 알림) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+: 세션 알림 표시 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- PRD-03: Android SpeechRecognizer 서비스 바인딩 (manifest 직속) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".AirCallApp"
        android:label="AirCall AI"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.AirCallAI">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PRD-05: 백그라운드 대화 세션. 지속 알림으로 마이크 사용을 표시한다. -->
        <service
            android:name=".service.ConversationService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
